name: Build NAD Network EXE
on: [push]

jobs:
  build:
    runs-on: windows-latest
    steps:
    - uses: actions/checkout@v3
    - name: Setup Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.9'
    - name: Install Dependencies
      run: |
        pip install kivy[base] kivymd pyinstaller
    - name: Build EXE
      run: |
        pyinstaller --onefile --windowed --name "NAD_Network_Repair_2026" global_ui.py
    - name: Upload Artifact
      uses: actions/upload-artifact@v3
      with:
        name: Network_Repair_Tool
        path: dist/NAD_Network_Repair_2026.exe
